# ---------------------------------------------------------------------------
# Brill Legal — environment variables
# Copy to `.env.local` for development, or set in your host (Vercel) dashboard.
# Everything WordPress-related is OPTIONAL: leave WP_GRAPHQL_ENDPOINT unset and
# the site serves the in-repo content. Set it to switch to headless WordPress.
# ---------------------------------------------------------------------------

# Public site URL (used for canonicals, sitemap, schema). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://brilllegal.in

# Google Analytics 4 measurement ID (optional). Enables the gtag script +
# conversion events (generate_lead, click_whatsapp, click_call).
NEXT_PUBLIC_GA_ID=

# --- Headless WordPress (optional) -----------------------------------------
# WPGraphQL endpoint of the CMS. When set, content is pulled from WordPress.
# e.g. https://cms.brilllegal.in/graphql
WP_GRAPHQL_ENDPOINT=

# Application Password credentials for an Editor account — required only for
# writing enquiries (the contact form) back to WordPress.
WP_APP_USERNAME=
WP_APP_PASSWORD=

# Shared secret for the on-demand revalidation webhook (/api/revalidate).
# Generate a long random string and configure the same value in WordPress.
WP_REVALIDATE_SECRET=
