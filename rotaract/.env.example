# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. With no .env at all the site runs completely:
# reads come from the seed JSON in src/data, writes go to a local file store
# under .data/, and auth uses the mock accounts in src/data/users.json.
# ---------------------------------------------------------------------------

# --- Supabase (optional backend) -------------------------------------------
# Set both to switch every read/write over to Supabase. Leave unset for the
# local JSON + LocalStorage fallback.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Preferred over the anon key for API route writes.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Sessions ---------------------------------------------------------------
# HMAC secret for the signed session cookie. A development fallback is used if
# this is unset — set a real value before deploying anywhere public.
# SESSION_SECRET=generate-a-long-random-string

# --- Anonymous engagement ---------------------------------------------------
# Salt mixed into the daily-rotating visitor hash. Changing it resets every
# visitor's like/reaction ledger (counts are unaffected).
# ENGAGEMENT_SALT=another-long-random-string
